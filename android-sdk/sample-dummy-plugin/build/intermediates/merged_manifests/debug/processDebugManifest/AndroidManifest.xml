<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zzh.goodhub.sample.dummy"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="34"
        android:targetSdkVersion="35" />

    <application
        android:allowBackup="true"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="Dummy MCP Plugin" >
        <service
            android:name="com.zzh.goodhub.sample.dummy.DummyPluginService"
            android:exported="true" >
            <intent-filter>
                <action android:name="com.zzh.goodhub.action.MCP_SERVER" />
            </intent-filter>

            <meta-data
                android:name="com.zzh.goodhub.SERVER_ID"
                android:value="dummy" />
            <meta-data
                android:name="com.zzh.goodhub.SERVER_TITLE"
                android:value="Dummy 测试插件" />
        </service>

        <activity
            android:name="com.zzh.goodhub.sample.dummy.MainActivity"
            android:exported="true"
            android:label="Dummy MCP Plugin" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>