<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- G4 前台保活（thirdconnect §7）：INTERNET（网关 HTTP + 出站 MCP）+
         WifiLock（CHANGE_WIFI_STATE）+ WakeLock + 类型化 FGS（connectedDevice，
         minSdk 34 强制）+ 通知（Android 13+ 运行时授权，未授权仅通知隐藏） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- 端侧引擎 :engine 长生成 FGS 类型（on-device-npu-deployment §6.2：长生成选
         dataSync，禁 shortService 3min 超时；Android 14+ 类型强制权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 电池优化白名单（G4 遗留项，2026-10-23）：未加白名单时息屏进 Doze 会限网
         → PC 侧表现为「过段时间连接掉了」；宿主在网关设置页提供跳转入口。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- TC 本地插件鉴权（thirdconnect §1.2.6）：goodshare 侧 Service 已挂 signature
         权限，宿主须声明同名权限才可 bind；两包须同签名同批出包，否则 SecurityException -->
    <uses-permission android:name="com.zzh.goodhub.permission.MCP_SERVER" />
    <!-- 应用内自更新（self-update epic）：拉起系统安装器（Android 8+ 首次引导「安装未知应用」授权） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:label="拾圆"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- 端侧引擎（on-device S2-1 真机实证）：libQnnHtpV79Stub.so 的 NEEDED
             libcdsprpc.so 在 /vendor/lib64，不在应用链接命名空间搜索路径——
             uses-native-library 把它加入命名空间（Android 12+；required=false
             保持无 NPU 机型可装）。 -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <!-- TC-debug: 该 Oppo/ColorOS 机型的 Impeller(Vulkan) 后端静默不出首帧、
             闪屏不移除→黑屏；回退 Skia/OpenGL 以解锁真机验证。生产构建可按需移除。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <!-- PC 远程网关前台保活服务（G4，thirdconnect §7）：息屏/Doze 不断连 -->
        <service
            android:name=".GatewayForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- 端侧 NPU 引擎独立进程（on-device-npu-deployment §6.2 / on-device-capability §2）：
             常驻 1.8~2.4GB 模型，OOM/驱动 Panic 仅令主进程收 EngineDiedException 切云，
             不拖垮 Flutter 主进程；isolatedProcess 必须为 false（需访问 NPU 驱动/HAL）；
             foregroundServiceType=dataSync（长生成，禁 shortService；FGS 预挂时序归 S3-2）。 -->
        <service
            android:name=".EngineService"
            android:exported="false"
            android:isolatedProcess="false"
            android:foregroundServiceType="dataSync"
            android:process=":engine" />
        <!-- TC12 L2 醒目呼叫：专用全屏确认 Activity（息屏也能亮屏置顶；singleInstance
             避免与 MainActivity 同栈堆叠）；由网关全屏通知（FULL_SCREEN_INTENT）拉起。 -->
        <activity
            android:name=".L2AlertActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/NormalTheme" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 同机本地插件发现（thirdconnect T-trans-4，§1.2.4）：扫描声明该 Action 的服务 -->
        <intent>
            <action android:name="com.zzh.goodhub.action.MCP_SERVER" />
        </intent>
    </queries>
</manifest>
